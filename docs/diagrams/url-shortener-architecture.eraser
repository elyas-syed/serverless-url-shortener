// AWS URL Shortener — serverless architecture (horizontal layout for README / blog)
// Live: https://app.eraser.io/workspace/NjIOU5jPmHgeOj4OvVmO?diagram=r8o0_JSJPUNXFo8IWrvh&layout=canvas

direction right
colorMode pastel
styleMode shadow
typeface clean

title AWS URL Shortener (elyas.click) [typeface: clean]

Users [icon: users, label: "Browser / API client"]

Edge [color: blue] {
  Route53 [icon: aws-route-53]
  ACM [icon: aws-certificate-manager]
  CloudFront [icon: aws-cloudfront]
}

S3Web [icon: aws-simple-storage-service, label: "S3 frontend"]

APIGateway [icon: aws-api-gateway, label: "API Gateway HTTP API"]

LambdaFns [color: orange, label: Lambda] {
  CreateLink [icon: aws-lambda, label: create_link]
  Redirect [icon: aws-lambda, label: redirect]
  GetAnalytics [icon: aws-lambda, label: get_analytics]
  ClickTracker [icon: aws-lambda, label: click_tracker]
}

DynamoDB [color: purple, label: DynamoDB] {
  LinksTable [icon: aws-dynamodb, label: "links table"]
  RateLimitsTable [icon: aws-dynamodb, label: "rate_limits table"]
}

SQS [color: purple, label: SQS] {
  ClickQueue [icon: aws-simple-queue-service, label: click_events]
  DLQ [icon: aws-simple-queue-service, label: DLQ]
}

Route53 > CloudFront
ACM > CloudFront
Users > CloudFront

CloudFront > S3Web: static assets
CloudFront > APIGateway: API + redirects

APIGateway > CreateLink, Redirect, GetAnalytics

CreateLink > LinksTable
CreateLink > RateLimitsTable
Redirect > LinksTable
Redirect > ClickQueue: enqueue click
GetAnalytics > LinksTable

ClickQueue > ClickTracker
ClickTracker > LinksTable
ClickQueue --> DLQ: failed messages

legend [position: bottom-right] {
  [connection: -->, label: Async / DLQ path]
  [icon: aws-cloudfront, label: Single public entry]
  [icon: aws-lambda, label: Python 3.12 Lambdas]
}
