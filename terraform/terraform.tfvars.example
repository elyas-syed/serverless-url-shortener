aws_region            = "us-east-1"
project_name          = "url-shortener"
auth_mode             = "open"
rate_limit_per_minute = 5
default_link_ttl_days = 3

# Optional custom domain (leave empty to use CloudFront default domain).
domain_name    = ""
hosted_zone_id = ""

# Optional AWS WAF on CloudFront (~$5+/month minimum when true). See docs/cost.md.
enable_waf     = false
waf_rate_limit = 2000

tags = {
  Project = "url-shortener"
  Managed = "terraform"
}
